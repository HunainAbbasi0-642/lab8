#include <stdio.h>
int main() {
    int S[3][3], P[3][2], R[3][2];
    int profit[3], maxProfit;
    int i, j, k;
    char *products[] = {"Charger", "Earphones", "Cover"};




    printf("=== ENTER SALES QUANTITIES ===\n");
    for (i = 0; i < 3; i++) {
        printf("\nBranch %d:\n", i + 1);
        for (j = 0; j < 3; j++) {
            printf("Enter %s quantity sold: ", products[j]);
            scanf("%d", &S[i][j]);  
        }
    }




    printf("\n=== ENTER PRODUCT PRICES ===\n");
    for (i = 0; i < 3; i++) {
        printf("\nProduct: %s\n", products[i]);
        printf("Enter cost price: ");
        scanf("%d", &P[i][0]);
        printf("Enter selling price: ");
        scanf("%d", &P[i][1]);
    }




    for (i = 0; i < 3; i++) {
        for (j = 0; j < 2; j++) {
            R[i][j] = 0;
            for (k = 0; k < 3; k++) {
                R[i][j] += S[i][k] * P[k][j];
            }
        }
        profit[i] = R[i][1] - R[i][0];
    }




    printf("\n=== ORIGINAL BILL ===\n");
    printf("Branch\tCost\tSales\tProfit\n");
    maxProfit = profit[0];
    for (i = 0; i < 3; i++) {
        printf("%d\t%d\t%d\t%d\n",
               i + 1, R[i][0], R[i][1], profit[i]);
        if (profit[i] > maxProfit)
            maxProfit = profit[i];
    }
    printf("Highest profit: Rs. %d\n", maxProfit);
    printf("Highest profit branch(es): ");
    for (i = 0; i < 3; i++) {
        if (profit[i] == maxProfit)
            printf("Branch %d ", i + 1);
    }
    printf("\n");




    for (i = 0; i < 3; i++) {
        P[i][1] = P[i][1] * 90 / 100;
    }




    for (i = 0; i < 3; i++) {
        for (j = 0; j < 2; j++) {
            R[i][j] = 0;
            for (k = 0; k < 3; k++) {
                R[i][j] += S[i][k] * P[k][j];
            }
        }
        profit[i] = R[i][1] - R[i][0];
    }




    printf("\n=== BILL AFTER 10%% DISCOUNT ===\n");
    printf("Branch\tCost\tSales\tProfit\n");
    maxProfit = profit[0];
    for (i = 0; i < 3; i++) {
        printf("%d\t%d\t%d\t%d\n",
               i + 1, R[i][0], R[i][1], profit[i]);
        if (profit[i] > maxProfit)
            maxProfit = profit[i];
    }
    printf("Highest profit: Rs. %d\n", maxProfit);
    printf("Highest profit branch(es): ");
    for (i = 0; i < 3; i++) {
        if (profit[i] == maxProfit)
            printf("Branch %d ", i + 1);
    }
    printf("\n");
    return 0;
}
